#include "stm32f4xx.h"

// --- Global Variables ---
int count = 0;         
int is_running = 0; 

void GPIO_Init(void);
void Display_Value(int val);
void Delay_ms(int ms);

int main(void) {
    GPIO_Init();
    
    while (1) {
        Display_Value(count); // Update 7-segment displays

        if (!is_running) {
            // --- Input: SET TIME (SW3 on PB0) ---
            // Check if PB0 is LOW (pressed)
            if (!(GPIOB->IDR & (1 << 0))) { 
                count++;
                if (count > 99) count = 0; 
                
                // Visual feedback: blink display briefly
                GPIOC->ODR = 0; 
                Delay_ms(150); 
            }
            // --- Input: START (SW1 on PA2) ---
            if (!(GPIOA->IDR & (1 << 2)) && count > 0) { 
                is_running = 1;
            }
        }

        // --- Input: RESET (SW2 on PA3) ---
        if (!(GPIOA->IDR & (1 << 3))) {
            is_running = 0;
            count = 0;
        }

        // --- Countdown Logic ---
        if (is_running) {
            GPIOB->ODR |= (1 << 12); // Blue LED ON
            Delay_ms(1000);          
            
            if (count > 0) {
                count--;
            } else {
                is_running = 0;      
            }
        } else {
            GPIOB->ODR &= ~(1 << 12); // Blue LED OFF
        }
    }
}
void Display_Value(int val) {
    const uint8_t map[] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};
    GPIOC->ODR = (map[(val / 10) % 10] << 8) | map[val % 10]; //
}

void Delay_ms(int ms) {
    for (volatile int i = 0; i < (ms * 1100); i++); 
}
